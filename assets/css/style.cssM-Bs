* {
    margin: 0;
    padding: 0;
 
   box-sizing: border-box;
    font-family: 'Arial', sans-serif;
}

body {
    background: #050816;
    color: white;
}

/* HERO */
.hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at top, #1a1f4f, #050816);
}

/* glowing shapes */
.hero::before,
.hero::after {
    content: "";
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.4;
    animation: float 6s infinite alternate;
}

.hero::before {
    background: #00c6ff;
    top: 10%;
    left: 10%;
}

.hero::after {
    background: #7f00ff;
    bottom: 10%;
    right: 10%;
}

@keyframes float {
    from { transform: translateY(0px); }
    to { transform: translateY(40px); }
}

/* glass card */
.hero-content {
    position: relative;
    z-index: 2;
    max-width: 850px;
    padding: 40px;
    background: rgba(255,255,255,0.05);
    border-radius: 20px;
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
}

/* heading */
.hero h1 {
    font-size: 50px;
    margin-bottom: 15px;
    background: linear-gradient(90deg, #00c6ff, #7f00ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: glow 2s infinite alternate;
}

@keyframes glow {
    from { filter: drop-shadow(0 0 5px #00c6ff); }
    to { filter: drop-shadow(0 0 20px #7f00ff); }
}

.hero p {
    font-size: 18px;
    color: #ccc;
    margin-bottom: 25px;
    line-height: 1.6;
}

/* buttons */
.buttons {
    margin-bottom: 20px;
}

.btn {
    display: inline-block;
    padding: 14px 32px;
    margin: 5px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
    box-shadow: 0 5px 20px rgba(0,0,0,0.4);
}

.primary {
    background: linear-gradient(90deg, #00c6ff, #0072ff);
    color: white;
}

.primary:hover {
    transform: scale(1.05);
}

.secondary {
    background: linear-gradient(90deg, #25D366, #128C7E);
    color: white;
}

.secondary:hover {
    transform: scale(1.05);
}

/* features */
.features span {
    display: inline-block;
    margin: 6px 10px;
    font-size: 14px;
    color: #aaa;
    background: rgba(255,255,255,0.05);
 9   padding: 6px 12px;
    border-radius: 20px;
}

/* MOBILE */
@media (max-width: 768px) {
    .hero h1 {
        font-size: 30px;
    }

    .hero-content {
        padding: 20px;
        margin: 15px;
    }
}
