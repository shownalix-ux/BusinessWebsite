/* ===== THEME ===== */
:root{
  --bg:#0F172A;
  --card:#1E293B;
  --primary:#2563EB;
  --secondary:#06B6D4;
  --accent:#F59E0B;
  --text:#FFFFFF;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

.container{
  width:90%;
  max-width:1200px;
  margin:auto;
}

/* ===== NAVBAR ===== */
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 8%;
  background:#111827;
  position:sticky;
  top:0;
}

.logo{
  font-size:24px;
  font-weight:bold;
  color:var(--primary);
}

.nav-links{
  display:flex;
  list-style:none;
  gap:25px;
}

.nav-links a{
  color:#fff;
  text-decoration:none;
}

.nav-links a:hover{
  color:var(--secondary);
}

/* ===== HERO ===== */
.hero{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:40px;
  background:linear-gradient(135deg,#0F172A,#1E293B);
}

.hero h1{
  font-size:3rem;
  margin-bottom:20px;
}

.hero p{
  font-size:1.2rem;
  margin-bottom:30px;
}

/* ===== BUTTONS ===== */
.btn{
  display:inline-block;
  padding:14px 28px;
  border-radius:10px;
  text-decoration:none;
  color:#fff;
  background:linear-gradient(90deg,#2563EB,#06B6D4);
  transition:.3s;
}

.btn:hover{
  transform:translateY(-3px);
}

/* ===== SERVICES ===== */
.services{
  padding:80px 20px;
}

.service-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.service-card{
  background:var(--card);
  padding:25px;
  border-radius:15px;
  transition:.3s;
}

.service-card:hover{
  transform:translateY(-8px);
}
